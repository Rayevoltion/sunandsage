<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/png" href="/assets/img/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Figtree:wght@400;500;600&family=Questrial&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "{{ site.name }}",
  "description": "{{ site.description }}",
  "url": "{{ site.url }}",
  "image": "{{ site.url }}/assets/img/og-image.jpg",
  "areaServed": "{{ site.serviceArea }}",
  "address": { "@type": "PostalAddress", "addressLocality": "Boulder", "addressRegion": "CO", "addressCountry": "US" }{% if site.email %},
  "email": "{{ site.email }}"{% endif %}{% if site.phone %},
  "telephone": "{{ site.phone }}"{% endif %}
}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="{{ site.name }} home">
      <img src="/assets/img/mark-sm.png" alt="" width="54" height="48">
      <span class="brand-text"><span class="brand-name">Sun &amp; Sage</span><span class="brand-sub">Spaces</span></span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      {% set links = [["/services/","Services"],["/botanicals/","Botanicals"],["/about/","About"],["/faq/","FAQ"]] %}
      {% for l in links %}<a href="{{ l[0] }}"{% if page.url == l[0] %} aria-current="page"{% endif %}>{{ l[1] }}</a>{% endfor %}
      {% include "cta.njk" %}
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap footer-col">
    <img src="/assets/img/logo.png" alt="{{ site.name }}. {{ site.tagline }}" width="240" height="237" loading="lazy">
    <nav class="footer-nav" aria-label="Footer">
      <a href="/services/">Services</a>
      <a href="/botanicals/">Botanicals</a>
      <a href="/about/">About</a>
      <a href="/faq/">FAQ</a>
      <a href="/contact/">Contact</a>
      {% if site.instagram %}<a href="https://instagram.com/{{ site.instagram | replace('@','') }}" rel="noopener">Instagram</a>{% endif %}
    </nav>
    <p class="fine">© {{ "" | year }} {{ site.name }} · Boulder, Colorado</p>
  </div>
</footer>
{% if site.typeformId %}<script src="https://embed.typeform.com/next/embed.js" defer></script>{% endif %}
<script src="/assets/js/main.js" defer></script>
</body>
</html>
